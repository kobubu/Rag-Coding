{
  "name": "rag-coding",
  "version": "0.1.0",
  "private": true,
  "description": "RAG Coding specifications and TypeScript structural diagnostics",
  "type": "module",
  "engines": {
    "node": "^22.17.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "node dist/scripts/check_docs.js",
    "test": "node --test dist/tests/*.test.js",
    "probe": "node dist/scripts/probe_chunking.js",
    "backlog": "node dist/scripts/render_backlog.js",
    "verify": "npm run build && npm run check && npm test && npm run probe"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "typescript": "6.0.3"
  }
}
