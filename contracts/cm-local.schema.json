{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Code Memory index v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "snapshot_id", "analysis_config_hash", "analysis_inputs", "analyzer", "capabilities", "files", "units", "symbols", "relations", "diagnostics", "limits"],
  "properties": {
    "format": {"const": "code-memory-0.1"},
    "snapshot_id": {"type": "string", "pattern": "^snapshot:[0-9a-f]{64}$"},
    "analysis_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analysis_inputs": {"type": "array", "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "analyzer": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "typescript-compiler"}, "version": {"type": "string"}}},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "limits": {"type": "array", "items": {"type": "string"}},
    "files": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/file"}},
    "units": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/unit"}},
    "symbols": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/symbol"}},
    "relations": {"type": "array", "maxItems": 500000, "items": {"$ref": "#/$defs/relation"}},
    "diagnostics": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "code", "message"], "properties": {"path": {"type": "string"}, "code": {"type": "integer"}, "message": {"type": "string"}}}}
  },
  "$defs": {
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["file_version_id", "start_byte", "end_byte", "line_start", "line_end"],
      "properties": {"file_version_id": {"type": "string", "pattern": "^blob:[0-9a-f]{64}$"}, "start_byte": {"type": "integer", "minimum": 0}, "end_byte": {"type": "integer", "minimum": 0}, "line_start": {"type": "integer", "minimum": 1}, "line_end": {"type": "integer", "minimum": 1}}
    },
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "source"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source": {"type": "string"}}},
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "name", "kind", "parent_id", "span", "required_symbol_ids"],
      "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "name": {"type": "string"}, "kind": {"enum": ["file", "type", "function", "method", "block"]}, "parent_id": {"type": ["string", "null"]}, "span": {"$ref": "#/$defs/span"}, "required_symbol_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}
    },
    "symbol": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "qualified_name", "kind", "path", "span", "declaration_span", "owner_unit_id"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "qualified_name": {"type": "string"}, "kind": {"type": "string"}, "path": {"type": "string"}, "span": {"$ref": "#/$defs/span"}, "declaration_span": {"$ref": "#/$defs/span"}, "owner_unit_id": {"type": "string"}}
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "from_id", "to_id", "predicate", "evidence"],
      "properties": {"id": {"type": "string"}, "from_id": {"type": "string"}, "to_id": {"type": "string"}, "predicate": {"enum": ["contains", "references", "calls", "captures"]}, "evidence": {"$ref": "#/$defs/span"}}
    }
  }
}
