{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rag-coding:contracts:core:0.1.0",
  "title": "RAG Coding proposed core contracts v0.1.0",
  "$defs": {
    "SourceSpan": {
      "type": "object",
      "properties": {
        "file_version_id": {
          "type": "string",
          "minLength": 1
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "file_version_id",
        "start_byte",
        "end_byte",
        "line_start",
        "line_end"
      ],
      "additionalProperties": false
    },
    "Origin": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "language_analyzer",
            "runtime_observation",
            "model",
            "human"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "definition",
            "occurrence",
            "binding",
            "contract",
            "registration",
            "runtime_trace",
            "semantic_quote"
          ]
        }
      },
      "required": [
        "span",
        "source_hash",
        "kind"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "repo_id": {
          "type": "string",
          "minLength": 1
        },
        "base_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "overlay_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "building",
            "ready",
            "failed",
            "superseded"
          ]
        },
        "analysis_config_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "snapshot_id",
        "repo_id",
        "base_commit",
        "overlay_hash",
        "state",
        "analysis_config_hash",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "EntityVersion": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "qualified_name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "variable",
            "parameter",
            "field",
            "function",
            "method",
            "type",
            "file",
            "module",
            "library"
          ]
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "definition_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "entity_id",
        "snapshot_id",
        "name",
        "qualified_name",
        "kind",
        "scope_id",
        "definition_spans"
      ],
      "additionalProperties": false
    },
    "CodeUnit": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_unit_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "file",
            "type",
            "function",
            "method",
            "nested_function",
            "block",
            "literal_fragment"
          ]
        },
        "source_span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "search_role": {
          "enum": [
            "primary",
            "secondary",
            "navigation_only"
          ]
        },
        "required_symbol_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "analysis_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema_version",
        "unit_id",
        "snapshot_id",
        "parent_unit_id",
        "kind",
        "source_span",
        "content_hash",
        "search_role",
        "required_symbol_ids",
        "analysis_fingerprint"
      ],
      "additionalProperties": false
    },
    "Relation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "from_id": {
          "type": "string",
          "minLength": 1
        },
        "to_id": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "enum": [
            "contains",
            "references",
            "calls",
            "captures",
            "reads",
            "writes",
            "imports",
            "implements",
            "control_depends_on",
            "test_references",
            "api_maps_to",
            "implements_behavior"
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "status": {
          "enum": [
            "derived",
            "candidate",
            "reviewed",
            "rejected",
            "stale"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        },
        "analysis_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema_version",
        "relation_id",
        "snapshot_id",
        "from_id",
        "to_id",
        "predicate",
        "origin",
        "status",
        "evidence",
        "analysis_fingerprint"
      ],
      "additionalProperties": false
    },
    "ContextPackage": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "unit_id": {
                "type": "string",
                "minLength": 1
              },
              "span": {
                "$ref": "#/$defs/SourceSpan"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "unit_id",
              "span",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "budget_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "tokens_used": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "tokenizer": {
          "type": "string",
          "minLength": 1
        },
        "completeness": {
          "enum": [
            "complete_for_declared_requirements",
            "partial"
          ]
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "target_id",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "package_id",
        "snapshot_id",
        "items",
        "budget_tokens",
        "tokens_used",
        "tokenizer",
        "completeness",
        "omissions",
        "diagnostics"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Snapshot"
    },
    {
      "$ref": "#/$defs/EntityVersion"
    },
    {
      "$ref": "#/$defs/CodeUnit"
    },
    {
      "$ref": "#/$defs/Relation"
    },
    {
      "$ref": "#/$defs/ContextPackage"
    }
  ]
}
